{
  "name": "voiceflow-automation",
  "version": "0.0.8",
  "pluginVersion": "0.0.20",
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.1",
    "@types/node": "^22.0.0",
    "oxlint": "^1.80.0",
    "typescript": "^7.0.2"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "oxlint xyops tests",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build:plugin": "PLUGIN_VERSION=$(bun -e \"console.log(require('./package.json').pluginVersion)\") && bun build xyops/plugin/entrypoint.ts --target=node --format=cjs --banner=\"// Voiceflow XYOps Event Plugin v$PLUGIN_VERSION\" --outfile=dist/voiceflow-event-plugin.cjs",
    "build:cli": "bun scripts/build-cli.ts",
    "build:cli:darwin-arm64": "bun scripts/build-cli.ts darwin-arm64",
    "build:cli:darwin-x64": "bun scripts/build-cli.ts darwin-x64",
    "build:cli:linux-arm64": "bun scripts/build-cli.ts linux-arm64",
    "build:cli:linux-x64": "bun scripts/build-cli.ts linux-x64",
    "build:cli:windows-x64": "bun scripts/build-cli.ts windows-x64",
    "bdd": "bun scripts/bdd-runners.ts",
    "verify:cli": "bun scripts/validate-cli-artifacts.ts",
    "check": "bun run lint && bun run typecheck && bun run test"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "zod": "^4.6.5"
  }
}
